/dts-v1/;

#include "imx93-nitrogen-smarc.dtsi"

/ {
	model = "Nitrogen93 SMARC on CORE SE-100";
	compatible = "fsl,imx93-nitrogen-smarc", "fsl,imx93";

	aliases {
		rtc0 = &rv3028;
		rtc1 = &bbnsm_rtc;
	};

	gpio-keys {
		compatible = "gpio-keys";

		din-a {
			label = "DIN A";
			linux,code = <KEY_A>;
			gpios = <&tca9535_1 0 GPIO_ACTIVE_HIGH>;
			wakeup-source;
			debounce-interval = <10>;
		};

		din-b {
			label = "DIN B";
			linux,code = <KEY_B>;
			gpios = <&tca9535_1 1 GPIO_ACTIVE_HIGH>;
			wakeup-source;
			debounce-interval = <10>;
		};

		din-c {
			label = "DIN C";
			linux,code = <KEY_C>;
			gpios = <&tca9535_1 2 GPIO_ACTIVE_HIGH>;
			wakeup-source;
			debounce-interval = <10>;
		};

		din-d {
			label = "DIN D";
			linux,code = <KEY_D>;
			gpios = <&tca9535_1 3 GPIO_ACTIVE_HIGH>;
			wakeup-source;
			debounce-interval = <10>;
		};
	};

	panel {
		compatible = "waveshare,7.0inch-c-panel", "panel-dpi";

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};

		panel-timing {
			clock-frequency = <51200000>;
			hactive = <1024>;
			vactive = <600>;
			hfront-porch = <160>;
			hback-porch = <140>;
			hsync-len = <20>;
			vback-porch = <12>;
			vfront-porch = <20>;
			vsync-len = <3>;

			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
			pixelclk-active = <1>;
		};
	};
};

&dphy {
	status = "okay";
};

&dsi {
	status = "okay";

	ports {
		port@1 {
			reg = <1>;
			dsi_out: endpoint {
				remote-endpoint = <&panel_in>;
			};
		};
	};
};

&flexcan1 {
	status = "okay";
};

&flexcan2 {
	status = "okay";
};

&lpi2c3 { /* SM_I2C_GP */
	status = "okay";

	tca9535_1: gpio@20 {
		compatible = "ti,tca9535";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_tca9535_1>;
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio3>;
		interrupts = <27 IRQ_TYPE_LEVEL_LOW>;
		wakeup-source;
		gpio-line-names = "P0_0 IN1_SOM", "P0_1 IN2_SOM", "P0_2 IN3_SOM",
					"P0_3 IN4_SOM", "P0_4 DIAG_EN_1V8",
					"P0_5 RS485_TERMTX", "P0_6 RS485_TERMRX",
					"P0_7 RS485_SLR",
					"P1_0 OUT4_EN_1V8", "P1_1 OUT3_EN_1V8",
					"P1_2 OUT2_EN_1V8", "P1_3 OUT1_EN_1V8",
					"P1_4 ST4_1V8", "P1_5 ST3_1V8",
					"P1_6 ST2_1V8", "P1_7 ST1_1V8";
	};

	tca9535_2: gpio@21 {
		compatible = "ti,tca9535";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_tca9535_2>;
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio3>;
		interrupts = <26 IRQ_TYPE_LEVEL_LOW>;
		wakeup-source;
		gpio-line-names = "P0_0 OE_EN", "P0_1 RS485_HF", "P0_2 RS232_ENABLE",
					"P0_3 RS232_INVALID", "P0_4 RTC_INT",
					"P0_5 TEMP_INT", "P0_6 TP49",
					"P0_7 TP50",
					"P1_0 FUSE_FLT", "P1_1 VDD5_EN",
					"P1_2 VDD33_EN", "P1_3 VDD_LTE_EN",
					"P1_4 VDD_SOM_EN", "P1_5 FUSE_SHDN",
					"P1_6 TP46", "P1_7 TP45";
	};

	tmp112: temperature@48 {
		compatible = "ti,tmp112";
		reg = <0x48>;
		//pinctrl-names = "default";
		//pinctrl-0 = <&pinctrl_tmp112>;
		//interrupt-parent = <&gpio2>; /* GPIO6 */
		//interrupts = <2 IRQ_TYPE_LEVEL_LOW>;
		//interrupt-parent = <&tca9535_2>; /* GPIO exp #2 P04 */
		//interrupts = <5 IRQ_TYPE_EDGE_FALLING>; /* pca953x only supports edge-triggered irq */
		//wakeup-source;
	};

	rv3028: rtc@52 {
		backup-switchover-dsm;
		#clock-cells = <0>;
		//pinctrl-names = "default";
		//pinctrl-0 = <&pinctrl_rv3028>;
		compatible = "microcrystal,rv3028";
		reg = <0x52>;
		interrupt-parent = <&tca9535_2>; /* GPIO exp #2 P04 */
		interrupts = <4 IRQ_TYPE_EDGE_FALLING>; /* pca953x only supports edge-triggered irq */
		//interrupt-parent = <&gpio4>;
		//interrupts = <29 IRQ_TYPE_LEVEL_LOW>; /* GPIO3 */
		wakeup-source;
	};
};

&lcdif {
	assigned-clock-rates = <484000000>, <121000000>, <400000000>, <133333333>;
	status = "okay";
};

&lpspi1 {
	status = "okay";

	spi1dev0: spi1@0 {
		reg = <0>;
		compatible = "lwn,bk4";
		spi-max-frequency = <1000000>;
	};

	spi1dev1: spi1@1 {
		reg = <1>;
		compatible = "lwn,bk4";
		spi-max-frequency = <1000000>;
	};
};

&lpspi3 {
	status = "okay";

	spi0dev0: spi0@0 {
		reg = <0>;
		compatible = "lwn,bk4";
		spi-max-frequency = <1000000>;
	};

	spi0dev1: spi0@1 {
		reg = <1>;
		compatible = "lwn,bk4";
		spi-max-frequency = <1000000>;
	};
};

&media_blk_ctrl {
	status = "okay";
};

&mu1 {
	status = "okay";
};

&mu2 {
	status = "okay";
};

&ocotp {
	status = "okay";
};

&sai3 { /* I2S0 */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sai3>;
	assigned-clocks = <&clk IMX93_CLK_SAI3>;
	assigned-clock-parents = <&clk IMX93_CLK_AUDIO_PLL>;
	/* wm8962 needs MCLK 14 - 40 MHz */
	assigned-clock-rates = <24000000>;
	fsl,sai-mclk-direction-output;
	status = "disabled";
};

&tpm5 { /* DSI / DISP_PWM0 Backlight */
	status = "okay";
};

&usbotg1 { /* USB-C / LTE */
	dr_mode = "host";
	disable-over-current;
	status = "okay";
};

&usbotg2 { /* USB HUB */
	dr_mode = "host";
	disable-over-current;
	samsung,picophy-pre-emp-curr-control = <3>;
	samsung,picophy-dc-vol-level-adjust = <7>;
	status = "okay";
};

&usdhc2 { /* SDIO - SDCARD */
	vmmc-supply = <&reg_usdhc2_vmmc>;
	status = "okay";
	no-sdio;
	no-mmc;
};

&iomuxc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_hog>;

	pinctrl_hog: hoggrp {
		fsl,pins = <
			MX93_PAD_CCM_CLKO3__GPIO4_IO28		0x31e /* VDD5_EN */
		>;
	};

	pinctrl_tca9535_1: tca9535-1grp {
		fsl,pins = <
			MX93_PAD_CCM_CLKO2__GPIO3_IO27				0x31e
		>;
	};

	pinctrl_tca9535_2: tca9535-2grp {
		fsl,pins = <
			MX93_PAD_CCM_CLKO1__GPIO3_IO26				0x31e
		>;
	};

	//pinctrl_rv3028: rv3028grp {
	//	fsl,pins = <
	//		MX93_PAD_CCM_CLKO4__GPIO4_IO29				0x31e
	//	>;
	//};
};
